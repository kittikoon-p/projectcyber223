@baseUrl = http://localhost:3000/api

### =========================================================
### SECURECHECK API - REST CLIENT
### =========================================================
### Roles:
###   USER  = ผู้ใช้งานทั่วไป
###   ADMIN = Administrator (มีได้เพียง 1 account)
###
### แนะนำ:
### 1. Register User
### 2. Login User
### 3. Copy JWT จาก Response มาใส่ @userToken
### 4. Login Admin
### 5. Copy JWT มาใส่ @adminToken
### =========================================================

@userToken = YOUR_USER_JWT_TOKEN
@adminToken = YOUR_ADMIN_JWT_TOKEN

@userId = 1
@scanId = 1
@resetToken = YOUR_RESET_TOKEN

### =========================================================
### 01 - USER AUTHENTICATION
### =========================================================

### USER - REGISTER
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "wutthipong",
    "email": "wutthipong-k@rmutp.ac.th",
    "password": "0911646466"
}

### USER - REGISTER ANOTHER USER
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "john",
    "email": "john@gmail.com",
    "password": "Password123!"
}

### USER - LOGIN
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "kittikoon-p@rmutp.ac.th",
    "password": "0911646466"
}

### USER - LOGIN WRONG PASSWORD (Expected: 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "wutthipong-k@rmutp.ac.th",
    "password": "0911646456"
}

### USER - LOGOUT
POST {{baseUrl}}/auth/logout
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MywiZW1haWwiOiJ3dXR0aGlwb25nLWtAcm11dHAuYWMudGgiLCJyb2xlIjoidXNlciIsImlhdCI6MTc5MTIwMjY3NywiZXhwIjoxNzkxMjAzNTc3fQ.ZJLQnIaDxeaqi-fB46ABmKOdTQYgKontPQ0M5BH_G5o

